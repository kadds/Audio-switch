<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="DolbyAccessAutoSwitch_WinUI.ProcessProfileView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="2" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="3">
            <TextBlock x:Name="ProcessTitleTextBlock" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock x:Name="ProcessDescriptionTextBlock" Text="Settings are stored independently for this process." Opacity="0.68" />
            <TextBlock x:Name="ProcessPathTextBlock" Text="Executable path: unavailable" Opacity="0.58" FontSize="12" TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1" RowSpacing="10" VerticalAlignment="Top">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Style="{StaticResource CardBorderStyle}" Padding="12">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <SymbolIcon Symbol="Link" VerticalAlignment="Center" />
                        <TextBlock x:Name="RuleMatchingTextBlock" Text="Rule matching" Style="{StaticResource SubtitleTextBlockStyle}" />
                    </StackPanel>
                    <TextBlock x:Name="RuleHintTextBlock" Text="Choose how this rule identifies the process." Opacity="0.68" TextWrapping="Wrap" />
                    <ComboBox x:Name="MatchModeComboBox" SelectionChanged="MatchModeComboBox_SelectionChanged">
                        <ComboBoxItem Tag="ProcessName" Content="Process name" />
                        <ComboBoxItem Tag="FullPath" Content="Full path" />
                    </ComboBox>
                    <CheckBox x:Name="ForegroundOnlyCheckBox" Content="Match only while this process owns the foreground window" Click="ForegroundOnlyCheckBox_Click" />
                    <TextBlock x:Name="ForegroundHintTextBlock" Text="When another window becomes active, the restore settings are applied." Opacity="0.68" TextWrapping="Wrap" />
                    <Grid ColumnSpacing="8" Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="160" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="PriorityOverrideLabelTextBlock" Text="Priority override" VerticalAlignment="Center" />
                        <NumberBox x:Name="PriorityOverrideNumberBox" Grid.Column="1" Minimum="-10000" Maximum="10000" SmallChange="1" SpinButtonPlacementMode="Compact" PlaceholderText="Auto" ValueChanged="PriorityOverrideNumberBox_ValueChanged" />
                    </Grid>
                    <TextBlock x:Name="PriorityOverrideHintTextBlock" Text="Leave blank to use automatic priority." Opacity="0.68" TextWrapping="Wrap" />
                    <TextBlock x:Name="OutputDeviceTitleTextBlock" Text="Output device" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,4,0,0" />
                    <TextBlock x:Name="OutputHintTextBlock" Text="When this process runs, route its audio streams to this endpoint." Opacity="0.68" TextWrapping="Wrap" />
                    <ComboBox x:Name="EndpointComboBox" DisplayMemberPath="DisplayName" HorizontalAlignment="Stretch" SelectionChanged="EndpointComboBox_SelectionChanged" />
                    <Grid ColumnSpacing="8" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ProcessVolumeLabelTextBlock" Text="Process volume" VerticalAlignment="Center" />
                        <TextBlock x:Name="ProcessVolumeValueTextBlock" Grid.Column="1" Text="Keep current" VerticalAlignment="Center" Opacity="0.72" />
                    </Grid>
                    <CheckBox x:Name="ProcessVolumeEnabledCheckBox" Content="Set volume for this process" Click="ProcessVolumeEnabledCheckBox_Click" />
                    <Slider x:Name="ProcessVolumeSlider" Minimum="0" Maximum="100" StepFrequency="1" Value="100" IsEnabled="False" ValueChanged="ProcessVolumeSlider_ValueChanged" />
                    <TextBlock x:Name="ProcessVolumeHintTextBlock" Text="Disabled means keep the current process volume." Opacity="0.62" FontSize="12" TextWrapping="Wrap" />
                    <TextBlock x:Name="CurrentSpatialTextBlock" Text="Current spatial audio" Opacity="0.68" Margin="0,8,0,0" />
                    <TextBlock x:Name="CurrentMatchTextBlock" Text="No output device selected." TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="12">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <SymbolIcon Symbol="Audio" VerticalAlignment="Center" />
                        <TextBlock x:Name="SpatialLogicTextBlock" Text="Spatial audio logic" Style="{StaticResource SubtitleTextBlockStyle}" />
                    </StackPanel>
                    <TextBlock x:Name="SpatialHintTextBlock" Text="The spatial format selects its provider automatically. Presets are available only when that format exposes one." Opacity="0.68" TextWrapping="Wrap" />
                    <TextBlock x:Name="SystemFormatTextBlock" Text="System spatial format" Opacity="0.68" />
                    <TextBlock x:Name="ActiveLabelTextBlock" Text="When process is active" FontSize="12" Opacity="0.58" />
                    <ComboBox x:Name="ActiveSpatialAudioModeComboBox" DisplayMemberPath="Name" SelectionChanged="ActiveSpatialAudioModeComboBox_SelectionChanged" />
                    <TextBlock x:Name="PresetTransitionTextBlock" Text="Preset transition" Opacity="0.68" />
                    <TextBlock x:Name="PresetHintTextBlock" Text="Preset selection follows the spatial format above." Opacity="0.58" FontSize="12" TextWrapping="Wrap" />
                    <TextBlock x:Name="ActivePresetTextBlock" Text="Active preset" Opacity="0.68" />
                    <ComboBox x:Name="ActiveProfileComboBox" SelectionChanged="ActiveProfileComboBox_SelectionChanged" />
                </StackPanel>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10">
            <Button Style="{StaticResource IconTextButtonStyle}" Click="TestActiveButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="7"><SymbolIcon Symbol="Play" /><TextBlock x:Name="TestActiveTextBlock" Text="Test active preset" /></StackPanel>
            </Button>
            <TextBlock x:Name="ProfileStatusTextBlock" VerticalAlignment="Center" Opacity="0.68" />
        </StackPanel>
    </Grid>
</UserControl>
